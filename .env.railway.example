# =============================================================================
# Railway Environment Variables Template
# =============================================================================
# Copy these to your Railway service environment variables
# Railway Dashboard → Service → Variables → Add Variables
# =============================================================================

# -----------------------------------------------------------------------------
# API SERVICE (ezmsg-api)
# -----------------------------------------------------------------------------

# Database - Use Railway reference variable
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Redis - Use Railway reference variable
REDIS_URL=${{Redis.REDIS_URL}}

# JWT Authentication - CHANGE THESE IN PRODUCTION!
JWT_SECRET=CHANGE-THIS-TO-A-SECURE-RANDOM-STRING-MIN-32-CHARACTERS-LONG
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - Update with your Railway frontend domain
CORS_ORIGINS=["https://your-ezmsg-web.up.railway.app"]

# Application Settings
SIMULATION_MODE=false
DEBUG=false
ENVIRONMENT=production

# Twilio SMS Configuration (Optional - for production SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Firebase Cloud Messaging (Optional - for mobile push notifications)
FCM_SERVER_KEY=your_fcm_server_key


# -----------------------------------------------------------------------------
# WORKER SERVICE (ezmsg-worker)
# -----------------------------------------------------------------------------

# Database - Use Railway reference variable
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Redis - Use Railway reference variable
REDIS_URL=${{Redis.REDIS_URL}}

# Worker Configuration
SIMULATION_MODE=false
POLL_INTERVAL_SECONDS=10
BATCH_SIZE=100
MAX_RETRY_ATTEMPTS=8

# Twilio (same as API service)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# FCM (same as API service)
FCM_SERVER_KEY=your_fcm_server_key


# -----------------------------------------------------------------------------
# WEB SERVICE (ezmsg-web)
# -----------------------------------------------------------------------------

# API URL - Use your Railway API domain (public URL)
NEXT_PUBLIC_API_URL=https://your-ezmsg-api.up.railway.app

# Build-time API URL
API_URL=https://your-ezmsg-api.up.railway.app/v1


# =============================================================================
# IMPORTANT NOTES
# =============================================================================
#
# 1. Railway Variable References:
#    - ${{Postgres.DATABASE_URL}} automatically gets the PostgreSQL connection string
#    - ${{Redis.REDIS_URL}} automatically gets the Redis connection string
#    - These work when services are linked in Railway
#
# 2. Public URLs:
#    - After deploying services, Railway generates domains like:
#      * https://ezmsg-api-production-xxxx.up.railway.app
#      * https://ezmsg-web-production-xxxx.up.railway.app
#    - Copy these and use them in CORS_ORIGINS and NEXT_PUBLIC_API_URL
#
# 3. Security:
#    - NEVER commit real secrets to Git
#    - Generate a secure JWT_SECRET: openssl rand -base64 48
#    - Use Railway's "Secret" type for sensitive variables
#
# 4. Custom Domains:
#    - After adding custom domains, update:
#      * CORS_ORIGINS in API service
#      * NEXT_PUBLIC_API_URL in Web service
#
# 5. Development vs Production:
#    - SIMULATION_MODE=true for testing (no real SMS)
#    - SIMULATION_MODE=false for production (real SMS via Twilio)
#
# =============================================================================
