# =============================================================================
# Railway Environment Variables Template
# =============================================================================
# Add these to each Railway service via Dashboard → Service → Variables.
# Use Railway's "Secret" type for sensitive values.
# =============================================================================

# --- API SERVICE (ezmsg-api) ------------------------------------------------

DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

ENVIRONMENT=production
DEBUG=false
SIMULATION_MODE=false

# Security — REQUIRED (generate: openssl rand -base64 48)
JWT_SECRET=
PROTOCOL_API_KEY=
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=

# Cookie domain (omit for Railway default; set for custom domain)
# COOKIE_DOMAIN=.yourdomain.com

# CORS — set to your actual frontend URL after deploy
CORS_ORIGINS=["https://your-ezmsg-web.up.railway.app"]

# Twilio SMS (required for real message delivery)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Firebase Cloud Messaging (required for push notifications)
FIREBASE_CREDENTIALS_PATH=

# --- WORKER SERVICE (ezmsg-worker) ------------------------------------------

# DATABASE_URL=${{Postgres.DATABASE_URL}}
# REDIS_URL=${{Redis.REDIS_URL}}
# SIMULATION_MODE=false
# TWILIO_ACCOUNT_SID=   (same as API)
# TWILIO_AUTH_TOKEN=     (same as API)
# TWILIO_PHONE_NUMBER=   (same as API)
# FIREBASE_CREDENTIALS_PATH=

# --- WEB SERVICE (ezmsg-web) ------------------------------------------------

# NEXT_PUBLIC_API_URL=https://your-ezmsg-api.up.railway.app
