# =============================================================================
# EzMsg — Environment Variables
# =============================================================================
# Copy to .env.local:  cp .env.example .env.local
# Docker Compose reads .env.local automatically.
# =============================================================================

# --- Database (Docker default: postgres on port 5433) ---
DATABASE_URL=postgresql+asyncpg://ezmsg:ezmsg_dev@localhost:5433/ezmsg

# --- Redis (Docker default: localhost:6379) ---
REDIS_URL=redis://localhost:6379

# --- Application ---
ENVIRONMENT=development
DEBUG=true
SIMULATION_MODE=true

# --- JWT Authentication ---
# Leave empty in dev (auto-generated). Set a strong 32+ char secret in prod.
JWT_SECRET=

# --- Protocol API Key ---
PROTOCOL_API_KEY=local-dev-key

# --- Admin Seed User ---
ADMIN_EMAIL=admin@ezmsg.local
ADMIN_PASSWORD=admin123

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Optional: Twilio SMS (leave empty for simulation mode) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Optional: Firebase Cloud Messaging ---
FIREBASE_CREDENTIALS_PATH=
