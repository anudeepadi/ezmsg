# =============================================================================
# EzMsg — Local Development Environment
# =============================================================================
# Copy this file to .env.local:  cp .env.local.example .env.local
# Then fill in your credentials below.
# =============================================================================

# --- Database (Supabase free tier: https://supabase.com) --------------------
# Format: postgresql+asyncpg://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.xxx.supabase.co:5432/postgres

# --- Redis (Upstash free tier: https://upstash.com) -------------------------
# Use rediss:// (double-s) for TLS
REDIS_URL=rediss://default:YOUR_PASSWORD@xxx.upstash.io:6379

# --- Application ------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
SIMULATION_MODE=true

# --- JWT Authentication ------------------------------------------------------
# Generate: openssl rand -base64 48
# If omitted in development, an ephemeral secret is auto-generated (tokens
# won't survive restarts). REQUIRED in production.
JWT_SECRET=

# --- Protocol API Key --------------------------------------------------------
# Shared secret for mobile/external clients calling /v1/protocol/* endpoints.
# Generate: openssl rand -hex 24
PROTOCOL_API_KEY=

# --- Admin Seed User ---------------------------------------------------------
# On first startup, an admin user is created with these credentials.
# If ADMIN_PASSWORD is empty in dev, a random password is generated and
# printed to the console. In production, you must set this explicitly.
ADMIN_EMAIL=admin@ezmsg.local
ADMIN_PASSWORD=

# --- CORS --------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]

# --- Optional: Twilio SMS (leave empty for simulation mode) ------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Optional: Firebase Cloud Messaging (leave empty for simulation mode) ----
FIREBASE_CREDENTIALS_PATH=
