# =============================================================================
# Local Development with External Free Databases
# =============================================================================
# Copy this file to .env.local and fill in your credentials
#
# Get Supabase PostgreSQL: https://supabase.com (free)
# Get Upstash Redis: https://upstash.com (free)
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase PostgreSQL Database
# -----------------------------------------------------------------------------
# Format: postgresql+asyncpg://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres
#
# Get this from:
# 1. Go to https://supabase.com
# 2. Create project
# 3. Settings → Database → Connection string → URI
# 4. Replace [YOUR-PASSWORD] with your actual password
#
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_SUPABASE_PASSWORD@db.xxx.supabase.co:5432/postgres


# -----------------------------------------------------------------------------
# Upstash Redis Cache
# -----------------------------------------------------------------------------
# Format: rediss://default:PASSWORD@xxx.upstash.io:6379
# Note: Use 'rediss://' (double s) for TLS encryption
#
# Get this from:
# 1. Go to https://upstash.com
# 2. Create Redis database
# 3. Copy connection string from dashboard
#
REDIS_URL=rediss://default:YOUR_UPSTASH_PASSWORD@xxx.upstash.io:6379


# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Generate a secure secret: openssl rand -base64 48
JWT_SECRET=local-dev-secret-key-at-least-32-characters-long-for-testing
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7


# -----------------------------------------------------------------------------
# CORS - Allowed Origins
# -----------------------------------------------------------------------------
# For local development, allow localhost:3000 (frontend)
CORS_ORIGINS=["http://localhost:3000"]


# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# SIMULATION_MODE=true means no real SMS sent (testing mode)
# DEBUG=true enables detailed error messages
SIMULATION_MODE=true
DEBUG=true
ENVIRONMENT=development


# -----------------------------------------------------------------------------
# Optional: Twilio SMS (leave empty for testing)
# -----------------------------------------------------------------------------
# Get credentials from https://www.twilio.com/console
# Only needed if you want to test real SMS sending
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=


# -----------------------------------------------------------------------------
# Optional: Firebase Cloud Messaging (leave empty for testing)
# -----------------------------------------------------------------------------
# Only needed if you want to test mobile push notifications
FCM_SERVER_KEY=


# =============================================================================
# QUICK SETUP CHECKLIST
# =============================================================================
#
# [ ] 1. Create Supabase account at https://supabase.com
# [ ] 2. Create new project, copy DATABASE_URL
# [ ] 3. Create Upstash account at https://upstash.com
# [ ] 4. Create Redis database, copy REDIS_URL
# [ ] 5. Copy this file to .env.local
# [ ] 6. Replace YOUR_SUPABASE_PASSWORD with actual password
# [ ] 7. Replace YOUR_UPSTASH_PASSWORD with actual password
# [ ] 8. Save .env.local
# [ ] 9. Run: cd api && source venv/bin/activate
# [ ] 10. Run: export $(cat ../.env.local | xargs)
# [ ] 11. Initialize database (see SETUP_FREE_DATABASES.md)
# [ ] 12. Start API: uvicorn app.main:app --reload --port 8000
# [ ] 13. Test: curl http://localhost:8000/health
#
# =============================================================================
