# EzMsg Production Environment Variables
# Copy this file to .env.production and fill in real values.
# NEVER commit the filled .env.production file.

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/ezmsg

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://default:password@host:6379

# ── Security (REQUIRED) ──────────────────────────────────────────────
# JWT secret: minimum 32 characters, generate with: openssl rand -base64 48
JWT_SECRET=

# Protocol API key for mobile app integration
PROTOCOL_API_KEY=

# Admin seed credentials
ADMIN_EMAIL=admin@yourorg.com
ADMIN_PASSWORD=

# ── CORS ──────────────────────────────────────────────────────────────
CORS_ORIGINS=["https://app.ezmsg.io"]

# ── API URL (for web container to reach API) ──────────────────────────
API_URL=http://api:8000/v1

# ── Twilio SMS (optional) ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Firebase / FCM (optional) ────────────────────────────────────────
# Path inside container, or use FIREBASE_CREDENTIALS_JSON for inline JSON
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=

# ── Monitoring (optional) ────────────────────────────────────────────
SENTRY_DSN=

# ── PII Encryption (optional) ────────────────────────────────────────
# AES-256 key (base64-encoded 32 bytes): openssl rand -base64 32
ENCRYPTION_KEY=
